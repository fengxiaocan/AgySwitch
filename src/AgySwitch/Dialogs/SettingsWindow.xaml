<Window x:Class="AgySwitch.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="680" SizeToContent="Height" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, Microsoft YaHei UI, -apple-system, sans-serif">
    <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="26" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Opacity="0.06" BlurRadius="20" Direction="270" ShadowDepth="4" />
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="#F0FDFA" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconGear}" Fill="{StaticResource BrandTeal}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="应用设置" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="配置 Antigravity CLI 路径及本地 .gemini 认证目录" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- Section 1: Paths -->
            <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Gemini Directory -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextSecondary}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Gemini 配置目录" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                        <TextBlock Text="Antigravity CLI 实际使用的 .gemini 目录，包含认证文件及 accounts 备份档案" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GeminiPathTextBox" Style="{StaticResource ModernTextBox}" TextChanged="GeminiPathTextBox_TextChanged" />
                            <Button Grid.Column="1" Content="选择目录" Click="BrowseGemini_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="GeminiStatusText" Text="正在检查目录..." FontSize="11" Foreground="{StaticResource SuccessGreen}" Margin="2,6,0,0" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,2,0,16" />

                    <!-- CLI Path -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconTerminal}" Fill="{StaticResource TextSecondary}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Antigravity CLI 程序路径 (agy.exe 或 antigravity.exe)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                        <TextBlock Text="用于执行额度查询 (/usage) 的官方命令行程序；留空则自动从系统 PATH 查找" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CliPathTextBox" Style="{StaticResource ModernTextBox}" TextChanged="CliPathTextBox_TextChanged" />
                            <Button Grid.Column="1" Content="选择文件" Click="BrowseCli_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="2,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="重新检测 PATH" Click="DetectCli_Click" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" />
                            <TextBlock x:Name="CliStatusBadge" Grid.Column="1" Text="检测状态" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section 2: Info Card -->
            <Border Background="#F1F5F9" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IconInfo}" Fill="{StaticResource BrandTeal}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,10,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="关于额度查询与文件安全" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="• 额度查询通过调用 CLI /usage 获取，仅在手动点击时运行，无后台轮询。" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,2" />
                        <TextBlock Text="• 认证文件仅在本地 .gemini 与账户目录间安全复制，不会向网络上传任何凭据。" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer -->
            <Grid>
                <TextBlock Text="Antigravity Account Switcher · 本地设置" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" MinWidth="80" />
                    <Button Content="保存设置" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="95" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
