<Window x:Class="AgySwitch.Dialogs.InputNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入账户名称" Width="460" SizeToContent="Height" MinHeight="230"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, Microsoft YaHei UI, -apple-system, sans-serif">
    <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Opacity="0.06" BlurRadius="16" Direction="270" ShadowDepth="3" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="#F0FDFA" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconEdit}" Fill="{StaticResource BrandTeal}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" Text="账户名称" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock x:Name="PromptText" Text="为这个账户输入一个容易识别的名称。" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="NameTextBox" Style="{StaticResource ModernTextBox}" FontSize="14" Margin="0,8,0,20" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" MinWidth="80" />
                <Button Content="保存" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="90" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
