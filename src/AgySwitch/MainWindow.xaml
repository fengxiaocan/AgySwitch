<Window x:Class="AgySwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity Account Switcher"
        Icon="Assets/AgySwitch.ico"
        Width="1080" Height="780" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI, Microsoft YaHei UI, -apple-system, sans-serif"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate x:Key="AccountCardTemplate">
            <Border Margin="0,0,0,10" Padding="16,14" CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="#F0FDF4" />
                                <Setter Property="BorderBrush" Value="{StaticResource BrandTeal}" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="12" Direction="270" ShadowDepth="2" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{Binding AvatarBgColor}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Initials}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Name & Current Badge -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            <Border Background="#DCFCE7" CornerRadius="10" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="当前" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Email & Credential Status -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Email, TargetNullValue=未识别邮箱}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CredentialStatus}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- Last Used -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconClock}" Fill="{StaticResource TextMuted}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding LastUsedAt, StringFormat='最近使用 · {0:MM-dd HH:mm}', TargetNullValue='尚未使用'}"
                                   FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="切换" Tag="{Binding}" Click="Switch_Click" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="IsEnabled" Value="{Binding HasCredentials}" />
                                    <Setter Property="Padding" Value="14,7" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Content" Value="✓ 当前账户" />
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Background" Value="#E2E8F0" />
                                            <Setter Property="Foreground" Value="#64748B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="更新备份" Tag="{Binding}" Click="UpdateBackup_Click" Style="{StaticResource SecondaryButton}" Padding="11,7" FontSize="12" Margin="0,0,6,0"
                                Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="重命名" Tag="{Binding}" Click="Rename_Click" Style="{StaticResource QuietButton}" Padding="8,6" Margin="0,0,2,0" />
                        <Button Content="打开目录" Tag="{Binding}" Click="OpenFolder_Click" Style="{StaticResource QuietButton}" Padding="8,6" Margin="0,0,2,0" />
                        <Button Content="删除" Tag="{Binding}" Click="Delete_Click" Style="{StaticResource DangerQuietButton}" Padding="8,6" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="QuotaModelCardTemplate">
            <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Model}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />

                    <!-- Weekly Period -->
                    <Grid Visibility="{Binding HasWeekly, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="7天周期额度" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding WeeklyRemaining, StringFormat='剩余 {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBar}" Value="{Binding WeeklyPercent}" Maximum="100" Margin="0,3,0,2" />
                        <TextBlock Grid.Row="2" Text="{Binding WeeklyResetAt, StringFormat='重置：{0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" />
                    </Grid>

                    <!-- Five Hour Period -->
                    <Grid Visibility="{Binding HasFiveHour, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="5小时周期额度" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding FiveHourRemaining, StringFormat='剩余 {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandTeal}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBar}" Value="{Binding FiveHourPercent}" Maximum="100" Margin="0,3,0,2" />
                        <TextBlock Grid.Row="2" Text="{Binding FiveHourResetAt, StringFormat='重置：{0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="10" ClipToBounds="True" Background="#F0FDFA" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" Opacity="0.08" BlurRadius="8" Direction="270" ShadowDepth="2" />
                    </Border.Effect>
                    <Image Source="Assets/AgySwitch-source.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Antigravity Account Switcher" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="多账户凭证管理与额度监控" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="OpenGeminiFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextSecondary}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="打开 .gemini" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="Settings_Click" Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGear}" Fill="{StaticResource TextSecondary}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="设置" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- Hero Quota & Current Account Card -->
                <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="16" ClipToBounds="True" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" Opacity="0.05" BlurRadius="16" Direction="270" ShadowDepth="3" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Hero Card Header (Dark Modern Gradient) -->
                        <Border Grid.Row="0" Padding="22,18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0F242A" Offset="0.0" />
                                    <GradientStop Color="#09171C" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Current Account Info -->
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#163842" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="当前登录账户" FontSize="11" FontWeight="SemiBold" Foreground="#5EEAD4" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="CurrentStateText" Text="当前认证文件状态：正在检查" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Path Data="{StaticResource IconUser}" Fill="#2DD4BF" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="CurrentEmailText" Text="正在读取..." FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                        <Button Click="CopyEmail_Click" ToolTip="复制当前邮箱" Style="{StaticResource QuietButton}" Padding="5,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCopy}" Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right Refresh & CLI Status -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="RefreshQuotaButton" Click="RefreshQuota_Click" Style="{StaticResource OrangeButton}" Padding="18,9" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconRefresh}" Fill="White" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="刷新额度" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="CliStatusText" Text="CLI 检测中" FontSize="11" Foreground="#94A3B8" TextAlignment="Right" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Hero Card Body (Countdown & Quota Details) -->
                        <Grid Grid.Row="1" Margin="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.8*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Countdown Box -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,14,0">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconClock}" Fill="{StaticResource BrandTeal}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="距下次额度重置" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                    <TextBlock x:Name="RemainingTimeText" Text="等待查询" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,4" FontFamily="Consolas, Segoe UI, sans-serif" />
                                    <TextBlock x:Name="ResetAtText" Text="刷新额度后显示重置时间" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />

                                    <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,14,0,12" />

                                    <TextBlock Text="最近查询时间" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock x:Name="QuotaUpdatedText" Text="尚未查询" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Right Quota Detail Panel -->
                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Quota Detail Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="额度使用明细" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock x:Name="QuotaStatusText" Text="点击「刷新额度」获取模型用量" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button x:Name="ToggleQuotaViewButton" Content="原始文本" Click="ToggleQuotaView_Click" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    </Grid>

                                    <!-- Card View Container -->
                                    <ScrollViewer x:Name="QuotaCardsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                        <Grid>
                                            <ItemsControl x:Name="QuotaCardsItems" ItemTemplate="{StaticResource QuotaModelCardTemplate}" />
                                            <Border x:Name="QuotaEmptyPrompt" Background="Transparent" Padding="10,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Path Data="{StaticResource IconInfo}" Fill="{StaticResource TextMuted}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                                    <TextBlock Text="尚未查询额度或无模型明细" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="点击上方「刷新额度」即可获取各模型详细用量" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Raw Output TextBox (Toggled) -->
                                    <Border x:Name="QuotaRawBorder" Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="6" Visibility="Collapsed">
                                        <TextBox x:Name="QuotaOutputText"
                                                 Text="额度查询结果会显示在这里。" MinHeight="180" MaxHeight="260" IsReadOnly="True" AcceptsReturn="True"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                                 Background="Transparent" Foreground="#E2E8F0" Padding="8"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Hero Card Footer -->
                        <Border Grid.Row="2" Background="#F1F5F9" Padding="18,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextMuted}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="当前配置路径：" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="GeminiPathText" Grid.Column="1" Text="" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Content="打开目录" Click="OpenGeminiFolder_Click" Style="{StaticResource QuietButton}" Padding="8,4" FontSize="11" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Accounts Section Header -->
                <Grid Margin="2,4,2,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="已保存账户" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <Border Background="#E2E8F0" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AccountCountText" Text="0 个账户档案" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        </Border>
                    </StackPanel>
                    <Button Click="SaveCurrent_Click" Style="{StaticResource OrangeButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="White" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="备份当前账户" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Accounts List or Empty View -->
                <Grid>
                    <ItemsControl x:Name="AccountsItems" ItemTemplate="{StaticResource AccountCardTemplate}" />
                    <Border x:Name="EmptyAccountsPanel" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="32,28"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="12" Direction="270" ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center" Margin="0,10">
                            <Border Width="48" Height="48" CornerRadius="24" Background="#F0FDFA" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="{StaticResource IconUser}" Fill="{StaticResource BrandTeal}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="还没有保存的账户档案" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="点击下方按钮备份当前 CLI 登录凭据，即可建立首个账户档案并随时切换。" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" TextAlignment="Center" />
                            <Button Click="SaveCurrent_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,9">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Fill="White" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="备份当前账户" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Accounts Storage Directory Bar -->
                <Border Background="#F1F5F9" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,8,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextMuted}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="档案存储路径：" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="AccountsPathText" Grid.Column="1" Text="" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="打开档案目录" Click="OpenAccountsFolder_Click" Style="{StaticResource QuietButton}" Padding="8,4" FontSize="11" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Status Bar -->
        <Grid Grid.Row="2" Margin="2,10,2,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="FooterStatusDot" Width="6" Height="6" Fill="{StaticResource SuccessGreen}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="FooterStatusText" Text="就绪" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Antigravity Account Switcher · Windows x64" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
