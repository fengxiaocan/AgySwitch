        <SolidColorBrush x:Key="BrandTeal" Color="#0D9488" />
        <SolidColorBrush x:Key="BrandTealHover" Color="#0F766E" />
        <SolidColorBrush x:Key="BrandDark" Color="#0F242A" />
        <SolidColorBrush x:Key="BrandOrange" Color="#EA580C" />
        <SolidColorBrush x:Key="BrandOrangeHover" Color="#C2410C" />
        <SolidColorBrush x:Key="AppBackground" Color="#F8FAFC" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBorderHighlight" Color="#CBD5E1" />
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondary" Color="#475569" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981" />
        <SolidColorBrush x:Key="SuccessGreenBg" Color="#ECFDF5" />
        <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="WarningAmberBg" Color="#FFFBEB" />
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444" />
        <SolidColorBrush x:Key="DangerRedBg" Color="#FEF2F2" />

